#!/usr/bin/env ruby
# Blocks commits that look like they contain an API key. The repo is public.
# Installed by `git config core.hooksPath .githooks`.
PATTERNS = [
  /sk-ant-[A-Za-z0-9_\-]{10,}/,             # Anthropic keys
  /Bearer\s+[A-Za-z0-9_\-\.]{20,}/,         # literal bearer tokens
  /(api[_-]?key|secret|token)["']?\s*[:=]\s*["'][A-Za-z0-9_\-]{20,}["']/i
].freeze

diff = `git diff --cached -U0 --no-color`
hits = diff.lines.select { |l| l.start_with?("+") && !l.start_with?("+++") && PATTERNS.any? { |p| p.match?(l) } }
exit 0 if hits.empty?

warn "Commit blocked: these added lines look like secrets:"
hits.each { |l| warn "  #{l.strip[0, 80]}" }
exit 1
